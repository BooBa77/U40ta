{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictPropertyInitialization": false,
    // Явный список глобальных типов. `multer` здесь потому, что он объявляет
    // `Express.Multer.File` глобально, а в коде u40ta — в отличие от ph — модуль
    // `multer` нигде не импортируется, поэтому до этой правки тип не находился.
    "types": ["node", "multer"],
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "useUnknownInCatchVariables": false
  }
}
