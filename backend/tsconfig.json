{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    // Полный строгий режим, как в ph: `strict` включает noImplicitAny,
    // strictNullChecks, useUnknownInCatchVariables, strictBindCallApply и
    // noFallthroughCasesInSwitch. Единственное послабление — инициализация
    // свойств: сущности TypeORM заполняются из базы, а не конструктором.
    "strict": true,
    "strictPropertyInitialization": false,
    // Явный список глобальных типов. `multer` здесь потому, что он объявляет
    // `Express.Multer.File` глобально, а в коде u40ta — в отличие от ph — модуль
    // `multer` нигде не импортируется, поэтому до этой правки тип не находился.
    "types": ["node", "multer"],
    "forceConsistentCasingInFileNames": true
  }
}
